  "info": {
    "title": "Shop API",
    "description": "API bán hàng của khóa học NestJS. Lỗi luôn là application/problem+json (RFC 9457).",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "products",
      "description": "Danh mục sản phẩm"
    },
    {
      "name": "orders",
      "description": "Đặt hàng"
    },
    {
      "name": "system",
      "description": "Kiểm tra sống"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key"
      }
    },
    "schemas": {
      "CreateProductDto": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "example": "AO-THUN-01",
            "pattern": "^[A-Z0-9-]{3,20}$",
            "description": "Được trim và đổi sang chữ hoa"
          },
          "name": {
            "type": "string",
            "example": "Áo thun cotton",
            "minLength": 1,
            "maxLength": 120
          },
          "price": {
            "type": "number",
            "example": 199000,
            "minimum": 0,
            "description": "VND, số nguyên"
          },
          "categoryId": {
            "type": "number",
            "example": 1,
            "minimum": 1,
            "default": 1
          },
          "brand": {
            "type": "string",
            "nullable": true,
            "maxLength": 80,
            "example": "Acme"
          },
          "stock": {
            "type": "number",
            "example": 25,
            "minimum": 0,
            "default": 0
          },
          "attributes": {
            "type": "object",
            "additionalProperties": true,
            "example": {
              "color": "black"
            }
          },
          "isActive": {
            "type": "boolean",
            "default": true
          }
        },
        "required": [
          "sku",
          "name",
          "price"
        ]
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 42
          },
          "categoryId": {
            "type": "number",
            "example": 1
          },
          "sku": {
            "type": "string",
            "example": "AO-THUN-01",
            "pattern": "^[A-Z0-9-]{3,20}$"
          },
          "name": {
            "type": "string",
            "example": "Áo thun cotton",
            "minLength": 1,
            "maxLength": 120
          },
          "brand": {
            "type": "string",
            "nullable": true,
            "example": "Acme"
          },
          "price": {
            "type": "number",
            "example": 199000,
            "minimum": 0,
            "description": "VND, số nguyên"
          },
          "stock": {
            "type": "number",
            "example": 25,
            "minimum": 0
          },
          "attributes": {
            "type": "object",
            "additionalProperties": true,
            "example": {
              "color": "black"
            }
          },
          "isActive": {
            "type": "boolean",
            "example": true
          },
          "createdAt": {
            "type": "string",
            "example": "2026-10-17T08:00:00.000Z",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "categoryId",
          "sku",
          "name",
          "brand",
          "price",
          "stock",
          "attributes",
          "isActive",
          "createdAt"
        ]
      },
      "PaginationMetaDto": {
        "type": "object",
        "properties": {
          "page": {
            "type": "number",
            "example": 1,
            "minimum": 1
          },
          "limit": {
            "type": "number",
            "example": 20,
            "minimum": 1,
            "maximum": 100
          },
          "total": {
            "type": "number",
            "example": 137,
            "description": "Tổng số bản ghi sau khi lọc"
          }
        },
        "required": [
          "page",
          "limit",
          "total"
        ]
      },
      "UpdateProductDto": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "example": "AO-THUN-01",
            "pattern": "^[A-Z0-9-]{3,20}$",
            "description": "Được trim và đổi sang chữ hoa"
          },
          "name": {
            "type": "string",
            "example": "Áo thun cotton",
            "minLength": 1,
            "maxLength": 120
          },
          "price": {
            "type": "number",
            "example": 199000,
            "minimum": 0,
            "description": "VND, số nguyên"
          },
          "categoryId": {
            "type": "number",
            "example": 1,
            "minimum": 1,
            "default": 1
          },
          "brand": {
            "type": "string",
            "nullable": true,
            "maxLength": 80,
            "example": "Acme"
          },
          "stock": {
            "type": "number",
            "example": 25,
            "minimum": 0,
            "default": 0
          },
          "attributes": {
            "type": "object",
            "additionalProperties": true,
            "example": {
              "color": "black"
            }
          },
          "isActive": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "PaginationV2Dto": {
        "type": "object",
        "properties": {
          "page": {
            "type": "number",
            "example": 1
          },
          "limit": {
            "type": "number",
            "example": 20
          },
          "total": {
            "type": "number",
            "example": 137
          },
          "pages": {
            "type": "number",
            "example": 7,
            "description": "ceil(total / limit)"
          }
        },
        "required": [
          "page",
          "limit",
          "total",
          "pages"
        ]
      },
      "ProductsPageV2Dto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Product"
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/PaginationV2Dto"
          }
        },
        "required": [
          "items",
          "pagination"
        ]
      },
      "CreateOrderItemDto": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "number",
            "example": 42,
            "minimum": 1
          },
          "quantity": {
            "type": "number",
            "example": 2,
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "productId",
          "quantity"
        ]
      },
      "CreateOrderDto": {
        "type": "object",
        "properties": {
          "items": {
            "minItems": 1,
            "maxItems": 50,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateOrderItemDto"
            }
          },
          "discountCode": {
            "type": "string",
            "nullable": true,
            "example": "WELCOME10",
            "pattern": "^[A-Za-z0-9-]{1,20}$"
          }
        },
        "required": [
          "items"
        ]
      },
      "OrderItem": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "number",
            "example": 42
          },
          "quantity": {
            "type": "number",
            "example": 2,
            "minimum": 1
          },
          "unitPrice": {
            "type": "number",
            "example": 199000,
            "description": "Giá tại thời điểm đặt (VND)"
          }
        },
        "required": [
          "productId",
          "quantity",
          "unitPrice"
        ]
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1001
          },
          "userId": {
            "type": "number",
            "example": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "paid",
              "shipped",
              "delivered",
              "cancelled",
              "refunded"
            ],
            "example": "pending"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            }
          },
          "shippingFee": {
            "type": "number",
            "example": 30000
          },
          "discountCode": {
            "type": "string",
            "nullable": true,
            "example": "WELCOME10"
          },
          "discountAmount": {
            "type": "number",
            "example": 39800
          },
          "totalAmount": {
            "type": "number",
            "example": 388200,
            "description": "Σ(unitPrice × quantity) + shippingFee − discountAmount"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-17T08:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-17T08:00:00.000Z"
          }
        },
        "required": [
          "id",
          "userId",
          "status",
          "items",
          "shippingFee",
          "discountCode",
          "discountAmount",
          "totalAmount",
          "createdAt",
          "updatedAt"
        ]
      },
      "FieldErrorDto": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "example": "items.1.quantity"
          },
          "message": {
            "type": "string",
            "example": "quantity must not be less than 1"
          }
        },
        "required": [
          "field",
          "message"
        ]
      },
      "ProblemDetailsDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "urn:shop:error:out-of-stock",
            "description": "Định danh ổn định để client rẽ nhánh"
          },
          "title": {
            "type": "string",
            "example": "Conflict"
          },
          "status": {
            "type": "number",
            "example": 409
          },
          "detail": {
            "type": "string",
            "example": "Sản phẩm #7 không đủ tồn kho (cần 5, còn 2)"
          },
          "instance": {
            "type": "string",
            "example": "/v1/orders"
          },
          "errors": {
            "description": "Chỉ có khi type = urn:shop:error:validation",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldErrorDto"
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance"
        ]
      }
    }
  }
}
