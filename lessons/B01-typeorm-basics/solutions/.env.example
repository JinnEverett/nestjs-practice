# Sao chép thành .env (hoặc .env.development / .env.test) rồi điền giá trị thật. KHÔNG commit file .env.
# Thứ tự ưu tiên: biến môi trường thật > .env.<NODE_ENV>.local > .env.<NODE_ENV> > .env > mặc định trong code (chỉ ngoài production).

NODE_ENV=development                 # development | test | production
PORT=3000                            # 1..65535

DATABASE_URL=postgres://postgres:postgres@localhost:5434/shop_dev
REDIS_URL=redis://localhost:6380

# Bắt buộc ở production: >= 32 ký tự, khác nhau. Sinh bằng: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars

# Bắt buộc ở production: >= 16 ký tự
ADMIN_API_KEY=change-me-admin-key

DEBUG_ENDPOINTS=false                # true chỉ cho dev/test; production bắt buộc false
DB_LOGGING=false                     # true: ghi mọi câu SQL ra log (chỉ khi điều tra)

SHIPPING_FEE=30000                   # VND, số nguyên >= 0
FREE_SHIPPING_THRESHOLD=500000       # VND, số nguyên >= 0
